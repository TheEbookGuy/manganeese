# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file.

# "development" or "production". In production, the app refuses to start
# if SECRET_KEY is still the placeholder value below.
ENVIRONMENT=development

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite for local/dev. For production, point this at PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/manganai
# (also uncomment psycopg2-binary in requirements.txt)
DATABASE_URL=sqlite:///./manganai.db

# Comma-separated list of allowed frontend origins. Add your real website
# domain(s) here before deploying, e.g. https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max upload size (MB) for training CSVs, raster files, production CSVs.
MAX_UPLOAD_MB=200

# Rate limits for auth endpoints (per client IP).
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute

PORT=8000
WEB_CONCURRENCY=5
GUNICORN_TIMEOUT=120
LOG_LEVEL=info
